# Kopieer dit bestand naar .env en vul de echte waarden in.
# .env wordt nooit gecommit (zie .gitignore).

# Telegram bot voor waarschuwingen (prijsafwijking + gefaalde runs).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Pad naar de SQLite-database. Relatief pad is t.o.v. de project-root
# (tools/competitor-monitor/).
DB_PATH=data/competitors.db

# Pad naar het YAML-configbestand.
SEARCH_CONFIG_PATH=config/search_config.yaml

# Pad naar de meest recente Hostaway CSV-export van eigen prijzen.
OWN_PRICES_CSV_PATH=data/own_prices.csv
